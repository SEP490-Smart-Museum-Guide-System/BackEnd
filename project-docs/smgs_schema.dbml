// =====================================================
// Smart Museum Guide System (SMGS) - DBML cho dbdiagram.io
// Dựa trên SMGS_Project_Context v1.2 (15/10/2026)
// Các bảng EF Core dùng tên vật lý và cấu trúc của BE. Các bảng đề xuất chưa có trong model được giữ lại.
// =====================================================

Project SMGS {
  database_type: 'PostgreSQL'
}

// ---------- ENUMS ----------
Enum content_status {
  draft
  pending_review
  published
  rejected
  archived
}
Enum access_level {
  free
  premium
}
Enum recognition_method {
  qr
  image
}
Enum tour_type {
  template
  ai
}
Enum visit_status {
  in_progress
  completed
  abandoned
}
Enum product_type {
  ticket
  digital_service
  combo
}
Enum order_status {
  pending
  paid
  failed
  cancelled
  refunded
  partially_refunded
}
Enum payment_status {
  pending
  success
  failed
}
Enum refund_status {
  requested
  approved
  rejected
  completed
}
Enum right_type {
  ticket
  digital_service
}
Enum right_status {
  inactive
  active
  used
  expired
  revoked
}
Enum quiz_entry_status {
  pending
  done
}
Enum attempt_mode {
  immediate
  later
}
Enum feedback_target {
  info
  tour
  chatbot
  overall
}
Enum feedback_status {
  visible
  hidden
}
Enum complaint_status {
  open
  processing
  resolved
  rejected
}
Enum chat_sender {
  user
  assistant
}
Enum node_type {
  artifact
  entrance
  stairs
  elevator
  junction
}
Enum length_level {
  short
  medium
  long
}
Enum detail_level {
  basic
  standard
  detailed
}

// =====================================================
// 1. IDENTITY
// =====================================================

Table Users {
  Id uuid [pk, not null]
  FullName varchar(200) [not null]
  IsActive boolean [not null, default: true]
  CreatedAt timestamptz [not null]
  UserName varchar(256)
  NormalizedUserName varchar(256)
  Email varchar(256)
  NormalizedEmail varchar(256)
  EmailConfirmed boolean [not null]
  PasswordHash text
  SecurityStamp text
  ConcurrencyStamp text
  PhoneNumber text
  PhoneNumberConfirmed boolean [not null]
  TwoFactorEnabled boolean [not null]
  LockoutEnd timestamptz
  LockoutEnabled boolean [not null]
  AccessFailedCount integer [not null]
  indexes {
    NormalizedEmail [unique, name: 'EmailIndex']
    NormalizedUserName [unique, name: 'UserNameIndex']
  }
}

Table Roles {
  Id uuid [pk, not null]
  Name varchar(256)
  NormalizedName varchar(256)
  ConcurrencyStamp text
  indexes {
    NormalizedName [unique, name: 'RoleNameIndex']
  }
}

Table UserRoles {
  UserId uuid [not null]
  RoleId uuid [not null]
  indexes {
    (UserId, RoleId) [pk]
    RoleId [name: 'IX_UserRoles_RoleId']
  }
}

// Hồ sơ mở rộng, tránh sửa bảng Identity
Table user_profiles {
  user_id uuid [pk, ref: - Users.Id]
  full_name varchar
  avatar_url varchar
  preferred_language_id int [ref: > languages.id]
  total_points int [not null, default: 0, note: 'Điểm tích lũy theo tài khoản']
  created_at timestamptz
}

// =====================================================
// 2. BẢO TÀNG - KHÔNG GIAN
// =====================================================

Table cities {
  Code varchar(2) [pk, not null]
  Name varchar(100) [not null]
}

Table museums {
  Id integer [pk, not null, increment]
  IndoorLayout varchar(20) [not null, default: 'unknown']
  Name varchar(200) [not null]
  Description text
  Address varchar(500)
  CityCode varchar(2)
  Latitude numeric(9,6)
  Longitude numeric(9,6)
  OpeningHours varchar(500)
  CoverImageUrl varchar(1000)
  IsActive boolean [not null, default: true]
  CreatedAt timestamptz [not null]
  indexes {
    CityCode [name: 'IX_museums_CityCode']
  }
}

Table buildings {
  Id integer [pk, not null, increment]
  MuseumId integer [not null]
  Name varchar(200) [not null]
  indexes {
    MuseumId [name: 'IX_buildings_MuseumId']
  }
}

Table floors {
  Id integer [pk, not null, increment]
  BuildingId integer [not null]
  LevelNo integer [not null]
  Name varchar(200)
  MapImageUrl varchar(1000)
  indexes {
    (BuildingId, LevelNo) [unique, name: 'IX_floors_BuildingId_LevelNo']
  }
}

Table galleries {
  Id integer [pk, not null, increment]
  FloorId integer [not null]
  Name varchar(300) [not null]
  Description text
  indexes {
    FloorId [name: 'IX_galleries_FloorId']
  }
}

Table staff_assignments {
  Id integer [pk, not null, increment]
  UserId uuid [not null]
  MuseumId integer [not null]
  GalleryId integer
  ArtifactId integer
  AssignedAt timestamptz [not null]
  // CREATE UNIQUE INDEX "IX_staff_assignments_UserId_MuseumId" ON staff_assignments ("UserId", "MuseumId") WHERE "GalleryId" IS NULL AND "ArtifactId" IS NULL;
  indexes {
    ArtifactId [name: 'IX_staff_assignments_ArtifactId']
    GalleryId [name: 'IX_staff_assignments_GalleryId']
    MuseumId [name: 'IX_staff_assignments_MuseumId']
  }
}

// =====================================================
// 3. HIỆN VẬT
// =====================================================

Table artifacts {
  Id integer [pk, not null, increment]
  MuseumId integer [not null]
  GalleryId integer
  Code varchar(100)
  Name varchar(300) [not null]
  QrCode varchar(200)
  MapNodeId integer
  MapX real
  MapY real
  MapIcon varchar(500)
  AccessLevel varchar(20) [not null, default: 'free']
  IsActive boolean [not null, default: true]
  CreatedAt timestamptz [not null]
  // CREATE UNIQUE INDEX "IX_artifacts_QrCode" ON artifacts ("QrCode") WHERE "QrCode" IS NOT NULL;
  indexes {
    GalleryId [name: 'IX_artifacts_GalleryId']
    MuseumId [name: 'IX_artifacts_MuseumId']
  }
}

Table artifact_reference_images [note: 'Ảnh tham chiếu để AI nhận diện']
{
  id int [pk, increment]
  artifact_id int [not null, ref: > artifacts.Id]
  image_url varchar [not null]
  embedding_ref varchar [note: 'Tham chiếu vector/đặc trưng phía AI nếu có']
}

Table topics {
  Id integer [pk, not null, increment]
  MuseumId integer [not null]
  Name varchar(200) [not null]
  Description varchar(2000)
  IsActive boolean [not null, default: true]
  CreatedAt timestamptz [not null]
  indexes {
    (MuseumId, Name) [unique, name: 'IX_topics_MuseumId_Name']
  }
}

Table artifact_topics {
  ArtifactId integer [not null]
  TopicId integer [not null]
  AssignedAt timestamptz [not null]
  indexes {
    (ArtifactId, TopicId) [pk]
    TopicId [name: 'IX_artifact_topics_TopicId']
  }
}

// =====================================================
// 4. NỘI DUNG ĐA NGÔN NGỮ + PHIÊN BẢN + DUYỆT
// =====================================================

Table languages {
  id int [pk, increment]
  code varchar [unique, not null, note: 'vi, en, ...']
  name varchar [not null]
  is_active boolean [default: true]
}

// BE quản lý thuyết minh theo ngôn ngữ, cùng văn bản và audio trong phiên bản nội dung.
Table artifact_contents {
  Id integer [pk, not null, increment]
  ArtifactId integer [not null]
  LanguageCode varchar(35) [not null]
  Revision uuid [not null]
  indexes {
    (ArtifactId, LanguageCode) [unique, name: 'IX_artifact_contents_ArtifactId_LanguageCode']
  }
}

Table artifact_content_versions {
  Id integer [pk, not null, increment]
  ArtifactContentId integer [not null]
  VersionNo integer [not null]
  Title varchar(300) [not null]
  Description text [not null]
  NarrationText text
  AudioUrl varchar(1000)
  IsAiGenerated boolean [not null]
  Status varchar(30) [not null]
  IsCurrent boolean [not null]
  CreatedBy uuid [not null]
  ReviewedBy uuid
  ReviewedAt timestamptz
  ReviewNote varchar(2000)
  PublishedAt timestamptz
  CreatedAt timestamptz [not null]
  // CREATE UNIQUE INDEX "IX_artifact_content_versions_ArtifactContentId" ON artifact_content_versions ("ArtifactContentId") WHERE "IsCurrent" = TRUE;
  indexes {
    (ArtifactContentId, VersionNo) [unique, name: 'IX_artifact_content_versions_ArtifactContentId_VersionNo']
    CreatedBy [name: 'IX_artifact_content_versions_CreatedBy']
    ReviewedBy [name: 'IX_artifact_content_versions_ReviewedBy']
  }
}

Table artifact_medias {
  Id integer [pk, not null, increment]
  ArtifactId integer [not null]
  MediaType varchar(30) [not null]
  Title varchar(300) [not null]
  LanguageCode varchar(35)
  FileName varchar(300) [not null]
  StorageKey varchar(200) [not null]
  ContentType varchar(100) [not null]
  FileSize bigint [not null]
  SortOrder integer [not null]
  CreatedBy uuid [not null]
  CreatedAt timestamptz [not null]
  indexes {
    ArtifactId [name: 'IX_artifact_medias_ArtifactId']
  }
}

// =====================================================
// 5. AI: NGUỒN KIẾN THỨC, CHATBOT
// =====================================================

Table source_documents [note: 'Tài liệu nguồn làm cơ sở cho chatbot']
{
  id int [pk, increment]
  museum_id int [not null, ref: > museums.Id]
  artifact_id int [ref: > artifacts.Id]
  title varchar [not null]
  file_url varchar
  content text
  status content_status [default: 'draft']
  uploaded_by uuid [ref: > Users.Id]
  approved_by uuid [ref: > Users.Id]
  approved_at timestamptz
  created_at timestamptz
}

Table conversations {
  id int [pk, increment]
  user_id uuid [not null, ref: > Users.Id]
  museum_id int [ref: > museums.Id]
  language_id int [ref: > languages.id]
  title varchar
  created_at timestamptz
}

Table conversation_artifacts [note: 'Một hội thoại có thể nói về nhiều hiện vật']
{
  conversation_id int [pk, ref: > conversations.id]
  artifact_id int [pk, ref: > artifacts.Id]
}

Table messages {
  id bigint [pk, increment]
  conversation_id int [not null, ref: > conversations.id]
  sender chat_sender [not null]
  content text [not null]
  created_at timestamptz
}

Table message_sources [note: 'Căn cứ trả lời của chatbot']
{
  message_id bigint [pk, ref: > messages.id]
  source_document_id int [pk, ref: > source_documents.id]
}

// =====================================================
// 6. BẢN ĐỒ NỘI BỘ (đề xuất cho chỉ đường tới hiện vật tiếp theo)
// =====================================================

Table indoor_maps {
  Id integer [pk, not null, increment]
  MuseumId integer [not null]
  FloorId integer
  Name varchar(200) [not null]
  Revision integer [not null]
  ImageKey text
  ImageWidth integer [not null]
  ImageHeight integer [not null]
  PublishedJson jsonb
  PublishedAt timestamptz
  // CREATE UNIQUE INDEX "IX_indoor_maps_FloorId" ON indoor_maps ("FloorId") WHERE "FloorId" IS NOT NULL;
  // CREATE UNIQUE INDEX "IX_indoor_maps_MuseumId" ON indoor_maps ("MuseumId") WHERE "FloorId" IS NULL;
}

Table map_nodes {
  Id uuid [pk, not null]
  IndoorMapId integer [not null]
  Label varchar(200) [not null]
  Type varchar(30) [not null]
  X float8 [not null]
  Y float8 [not null]
  indexes {
    (IndoorMapId, Id) [unique]
  }
  checks {
    `"X" BETWEEN 0 AND 1 AND "Y" BETWEEN 0 AND 1` [name: 'CK_map_nodes_xy']
  }
}

Table map_markers {
  Id uuid [pk, not null]
  IndoorMapId integer [not null]
  Label varchar(200) [not null]
  Type varchar(30) [not null]
  X float8 [not null]
  Y float8 [not null]
  ArtifactId integer
  GalleryId integer
  NodeId uuid
  IsDestination boolean [not null]
  IsActive boolean [not null]
  indexes {
    ArtifactId [name: 'IX_map_markers_ArtifactId']
    GalleryId [name: 'IX_map_markers_GalleryId']
    (IndoorMapId, NodeId) [name: 'IX_map_markers_IndoorMapId_NodeId']
  }
  checks {
    `"X" BETWEEN 0 AND 1 AND "Y" BETWEEN 0 AND 1` [name: 'CK_map_markers_xy']
  }
}

Table map_edges {
  Id uuid [pk, not null]
  IndoorMapId integer [not null]
  FromNodeId uuid [not null]
  ToNodeId uuid [not null]
  Bidirectional boolean [not null]
  IsAccessible boolean [not null]
  indexes {
    (IndoorMapId, FromNodeId, ToNodeId) [unique, name: 'IX_map_edges_IndoorMapId_FromNodeId_ToNodeId']
    (IndoorMapId, ToNodeId) [name: 'IX_map_edges_IndoorMapId_ToNodeId']
  }
  checks {
    `"FromNodeId" <> "ToNodeId"` [name: 'CK_map_edges_distinct']
  }
}

// =====================================================
// 7. TOUR VÀ LƯỢT THAM QUAN
// =====================================================

Table tours {
  Id integer [pk, not null, increment]
  MuseumId integer [not null]
  CreatedBy uuid [not null]
  Title varchar(200) [not null]
  Description varchar(4000) [not null]
  EstimatedMinutes integer [not null]
  Status varchar(20) [not null]
  Revision integer [not null]
  CreatedAt timestamptz [not null]
  indexes {
    CreatedBy [name: 'IX_tours_CreatedBy']
    MuseumId [name: 'IX_tours_MuseumId']
  }
}

Table tour_items {
  Id integer [pk, not null, increment]
  TourId integer [not null]
  ArtifactId integer [not null]
  OrderNo integer [not null]
  indexes {
    ArtifactId [name: 'IX_tour_items_ArtifactId']
    (TourId, ArtifactId) [unique, name: 'IX_tour_items_TourId_ArtifactId']
    (TourId, OrderNo) [unique, name: 'IX_tour_items_TourId_OrderNo']
  }
}

Table visits {
  Id integer [pk, not null, increment]
  VisitorId uuid [not null]
  TourId integer
  MuseumId integer [not null]
  StartedAt timestamptz [not null]
  CompletedAt timestamptz
  Status varchar(20) [not null]
  indexes {
    MuseumId [name: 'IX_visits_MuseumId']
    TourId [name: 'IX_visits_TourId']
    (VisitorId, MuseumId, Status) [name: 'IX_visits_VisitorId_MuseumId_Status']
  }
}

Table visit_items {
  Id integer [pk, not null, increment]
  VisitId integer [not null]
  ArtifactId integer [not null]
  TourItemId integer
  LastVisitedAt timestamptz [not null]
  indexes {
    ArtifactId [name: 'IX_visit_items_ArtifactId']
    TourItemId [name: 'IX_visit_items_TourItemId']
    (VisitId, ArtifactId) [unique, name: 'IX_visit_items_VisitId_ArtifactId']
  }
}

Table recognition_history {
  Id bigint [pk, not null, increment]
  UserId uuid [not null]
  VisitId integer
  ArtifactId integer
  Method varchar(20) [not null]
  IsSuccess boolean [not null]
  RecognizedAt timestamptz [not null]
  RequestId uuid [not null]
  indexes {
    ArtifactId [name: 'IX_recognition_history_ArtifactId']
    (UserId, RecognizedAt) [name: 'IX_recognition_history_UserId_RecognizedAt']
    (UserId, RequestId) [unique, name: 'IX_recognition_history_UserId_RequestId']
    VisitId [name: 'IX_recognition_history_VisitId']
  }
}

// =====================================================
// 8. QUIZ
// =====================================================

Table questions {
  Id integer [pk, not null, increment]
  ArtifactId integer [not null]
  LanguageCode varchar(35) [not null]
  Content varchar(4000) [not null]
  Explanation varchar(4000) [not null]
  Status varchar(20) [not null]
  CreatedBy uuid [not null]
  ReviewedBy uuid
  ReviewedAt timestamptz
  ReviewNote varchar(1000)
  CreatedAt timestamptz [not null]
  indexes {
    ArtifactId [name: 'IX_questions_ArtifactId']
    CreatedBy [name: 'IX_questions_CreatedBy']
    ReviewedBy [name: 'IX_questions_ReviewedBy']
  }
}

Table question_options {
  Id integer [pk, not null, increment]
  QuestionId integer [not null]
  Content varchar(1000) [not null]
  IsCorrect boolean [not null]
  OrderNo integer [not null]
  indexes {
    QuestionId [name: 'IX_question_options_QuestionId']
  }
}

Table quizzes {
  Id integer [pk, not null, increment]
  ArtifactId integer [not null]
  Title varchar(200) [not null]
  Status varchar(20) [not null]
  CreatedBy uuid [not null]
  QuestionsPerAttempt integer [not null]
  CreatedAt timestamptz [not null]
  indexes {
    ArtifactId [name: 'IX_quizzes_ArtifactId']
    CreatedBy [name: 'IX_quizzes_CreatedBy']
  }
}

Table quiz_questions {
  QuizId integer [not null]
  QuestionId integer [not null]
  indexes {
    (QuizId, QuestionId) [pk]
    QuestionId [name: 'IX_quiz_questions_QuestionId']
  }
}

Table daily_quiz_entries {
  Id bigint [pk, not null, increment]
  UserId uuid [not null]
  QuizId integer [not null]
  ArtifactId integer [not null]
  RecognitionId bigint [not null]
  VisitId integer
  EntryDate date [not null]
  Status varchar(20) [not null]
  CreatedAt timestamptz [not null]
  indexes {
    ArtifactId [name: 'IX_daily_quiz_entries_ArtifactId']
    QuizId [name: 'IX_daily_quiz_entries_QuizId']
    RecognitionId [name: 'IX_daily_quiz_entries_RecognitionId']
    (UserId, QuizId, EntryDate) [unique, name: 'IX_daily_quiz_entries_UserId_QuizId_EntryDate']
    VisitId [name: 'IX_daily_quiz_entries_VisitId']
  }
}

Table quiz_attempts {
  Id bigint [pk, not null, increment]
  UserId uuid [not null]
  QuizId integer [not null]
  DailyEntryId bigint [not null]
  Mode varchar(20) [not null]
  Status varchar(20) [not null]
  TotalQuestions integer [not null]
  CorrectCount integer [not null]
  Score integer [not null]
  StartedAt timestamptz [not null]
  CompletedAt timestamptz
  // CREATE UNIQUE INDEX "IX_quiz_attempts_DailyEntryId" ON quiz_attempts ("DailyEntryId") WHERE "Status" = 'in_progress';
  indexes {
    QuizId [name: 'IX_quiz_attempts_QuizId']
    UserId [name: 'IX_quiz_attempts_UserId']
  }
}

Table quiz_attempt_answers {
  Id bigint [pk, not null, increment]
  AttemptId bigint [not null]
  QuestionId integer [not null]
  SelectedOptionId integer
  IsCorrect boolean [not null]
  Points integer [not null]
  AnsweredAt timestamptz
  OrderNo integer [not null]
  indexes {
    (AttemptId, QuestionId) [unique, name: 'IX_quiz_attempt_answers_AttemptId_QuestionId']
    QuestionId [name: 'IX_quiz_attempt_answers_QuestionId']
    SelectedOptionId [name: 'IX_quiz_attempt_answers_SelectedOptionId']
  }
}

// =====================================================
// 9. ĐIỂM VÀ HUY HIỆU
// =====================================================

Table point_transactions {
  Id bigint [pk, not null, increment]
  UserId uuid [not null]
  Points integer [not null]
  Reason varchar(50) [not null]
  RefType varchar(50) [not null]
  RefId bigint [not null]
  CreatedAt timestamptz [not null]
  indexes {
    (UserId, Reason, RefType, RefId) [unique, name: 'IX_point_transactions_UserId_Reason_RefType_RefId']
  }
}

Table badges {
  Id integer [pk, not null, increment]
  MuseumId integer
  Code varchar(50) [not null]
  Name varchar(200) [not null]
  RuleJson jsonb [not null]
  indexes {
    Code [unique, name: 'IX_badges_Code']
    MuseumId [name: 'IX_badges_MuseumId']
  }
}

Table user_badges {
  UserId uuid [not null]
  BadgeId integer [not null]
  AwardedAt timestamptz [not null]
  indexes {
    (UserId, BadgeId) [pk]
    BadgeId [name: 'IX_user_badges_BadgeId']
  }
}

// =====================================================
// 10. THƯƠNG MẠI: VÉ / DỊCH VỤ SỐ / COMBO / THANH TOÁN
// =====================================================

// Thành phần combo nằm trong ResourceIdsJson. Mỗi đơn lưu một sản phẩm và giá tại thời điểm mua.
Table commerce_products {
  Id integer [pk, not null, increment]
  MuseumId integer [not null]
  Name varchar(200) [not null]
  Kind varchar(20) [not null]
  Price numeric(18,2) [not null]
  Currency varchar(3) [not null]
  Seats integer [not null]
  ValidityHours integer
  ValidityStartsAt text
  ResourceIdsJson text [not null]
  IsActive boolean [not null]
  indexes {
    MuseumId [name: 'IX_commerce_products_MuseumId']
  }
}

Table purchase_orders {
  Id uuid [pk, not null]
  BuyerId uuid [not null]
  MuseumId integer [not null]
  ProductId integer [not null]
  ProductName text [not null]
  ProductKind text [not null]
  Amount numeric(18,2) [not null]
  Currency varchar(3) [not null]
  Seats integer [not null]
  ValidityHours integer [not null]
  ValidityStartsAt text [not null]
  ResourceIdsJson text [not null]
  BuyerName text [not null]
  BuyerDetailsJson text [not null]
  Status text [not null]
  CreatedAt timestamptz [not null]
  PaidAt timestamptz
  ExpiresAt timestamptz
  GroupKeyHash varchar(64)
  indexes {
    (BuyerId, CreatedAt) [name: 'IX_purchase_orders_BuyerId_CreatedAt']
    GroupKeyHash [unique, name: 'IX_purchase_orders_GroupKeyHash']
    (MuseumId, PaidAt) [name: 'IX_purchase_orders_MuseumId_PaidAt']
    ProductId [name: 'IX_purchase_orders_ProductId']
  }
}

Table payment_attempts {
  Id uuid [pk, not null]
  OrderId uuid [not null]
  Status text [not null]
  Reference text
  FailureReason text
  ConfirmedBy uuid
  CreatedAt timestamptz [not null]
  CompletedAt timestamptz
  // CREATE UNIQUE INDEX "IX_payment_attempts_pending" ON payment_attempts ("OrderId") WHERE "Status" = 'pending';
  // CREATE UNIQUE INDEX "IX_payment_attempts_Reference" ON payment_attempts ("Reference") WHERE "Reference" IS NOT NULL;
  // CREATE UNIQUE INDEX "IX_payment_attempts_success" ON payment_attempts ("OrderId") WHERE "Status" = 'succeeded';
  indexes {
    ConfirmedBy [name: 'IX_payment_attempts_ConfirmedBy']
  }
}

Table museum_passes {
  Id uuid [pk, not null]
  OrderId uuid [not null]
  UserId uuid [not null]
  ClaimedAt timestamptz [not null]
  RevokedAt timestamptz
  indexes {
    (OrderId, UserId) [unique, name: 'IX_museum_passes_OrderId_UserId']
    UserId [name: 'IX_museum_passes_UserId']
  }
}

Table refunds [note: 'Hoàn tiền theo tỷ lệ %']
{
  id bigint [pk, increment]
  order_id uuid [not null, ref: > purchase_orders.Id]
  order_item_id bigint [note: 'Đề xuất cho hoàn tiền từng phần. BE chưa có dòng đơn hàng riêng.']
  percent decimal(5,2)
  amount decimal(12,2)
  status refund_status [default: 'requested']
  reason text
  processed_by uuid [ref: > Users.Id]
  requested_at timestamptz
  processed_at timestamptz
}

Table purchase_invoices {
  Id uuid [pk, not null]
  OrderId uuid [not null]
  Number text [not null]
  BuyerName text [not null]
  BuyerDetailsJson text [not null]
  ProductName text [not null]
  ProductKind text [not null]
  Seats integer [not null]
  Amount numeric(18,2) [not null]
  Currency text [not null]
  IssuedAt timestamptz [not null]
  indexes {
    Number [unique, name: 'IX_purchase_invoices_Number']
    OrderId [unique, name: 'IX_purchase_invoices_OrderId']
  }
}

// =====================================================
// 11. ĐÁNH GIÁ - PHẢN HỒI - KHIẾU NẠI
// =====================================================

Table visit_feedbacks {
  Id integer [pk, not null, increment]
  VisitId integer [not null]
  OverallRating integer [not null]
  ContentRating integer
  TourRating integer
  ChatbotRating integer
  Comment varchar(2000)
  ModerationStatus varchar(20) [not null, default: 'Visible']
  ModerationNote varchar(1000)
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz
  indexes {
    VisitId [unique, name: 'IX_visit_feedbacks_VisitId']
  }
  checks {
    `"ChatbotRating" IS NULL OR "ChatbotRating" BETWEEN 1 AND 5` [name: 'CK_visit_feedbacks_chatbot']
    `"ContentRating" IS NULL OR "ContentRating" BETWEEN 1 AND 5` [name: 'CK_visit_feedbacks_content']
    `"OverallRating" BETWEEN 1 AND 5` [name: 'CK_visit_feedbacks_overall']
    `"TourRating" IS NULL OR "TourRating" BETWEEN 1 AND 5` [name: 'CK_visit_feedbacks_tour']
  }
}

Table staff_responses {
  Id integer [pk, not null, increment]
  FeedbackId integer [not null]
  RespondedBy uuid [not null]
  Content varchar(2000) [not null]
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz
  indexes {
    FeedbackId [unique, name: 'IX_staff_responses_FeedbackId']
    RespondedBy [name: 'IX_staff_responses_RespondedBy']
  }
}

Table complaints {
  Id integer [pk, not null, increment]
  VisitorId uuid [not null]
  Subject varchar(300) [not null]
  Body varchar(5000) [not null]
  Status varchar(20) [not null, default: 'New']
  AssignedTo uuid
  ResolutionNote varchar(2000)
  CreatedAt timestamptz [not null]
  UpdatedAt timestamptz
  ResolvedAt timestamptz
  indexes {
    AssignedTo [name: 'IX_complaints_AssignedTo']
    Status [name: 'IX_complaints_Status']
    VisitorId [name: 'IX_complaints_VisitorId']
  }
}

// =====================================================
// 12. VẬN HÀNH
// =====================================================

Table audit_logs [note: 'Audit các thao tác quan trọng']
{
  id bigint [pk, increment]
  user_id uuid [ref: > Users.Id]
  museum_id int [ref: > museums.Id]
  action varchar [not null]
  entity_type varchar
  entity_id varchar
  old_data jsonb
  new_data jsonb
  ip_address varchar
  created_at timestamptz

  indexes {
    (entity_type, entity_id)
    created_at
  }
}

Table ai_quality_logs [note: 'Theo dõi lỗi và chất lượng AI (đề xuất)']
{
  id bigint [pk, increment]
  ai_type varchar [note: 'chatbot | recognition | narration | quiz']
  ref_id bigint
  is_error boolean
  score float
  detail text
  created_at timestamptz
}

// Bảng đã có trong BE, bổ sung theo tên vật lý

Table RoleClaims {
  Id integer [pk, not null, increment]
  RoleId uuid [not null]
  ClaimType text
  ClaimValue text
  indexes {
    RoleId [name: 'IX_RoleClaims_RoleId']
  }
}

Table UserClaims {
  Id integer [pk, not null, increment]
  UserId uuid [not null]
  ClaimType text
  ClaimValue text
  indexes {
    UserId [name: 'IX_UserClaims_UserId']
  }
}

Table UserLogins {
  LoginProvider text [not null]
  ProviderKey text [not null]
  ProviderDisplayName text
  UserId uuid [not null]
  indexes {
    (LoginProvider, ProviderKey) [pk]
    UserId [name: 'IX_UserLogins_UserId']
  }
}

Table UserTokens {
  UserId uuid [not null]
  LoginProvider text [not null]
  Name text [not null]
  Value text
  indexes {
    (UserId, LoginProvider, Name) [pk]
  }
}

Table artifact_3d_models {
  Id integer [pk, not null, increment]
  ArtifactId integer [not null]
  Name varchar(300) [not null]
  FileName varchar(300) [not null]
  StorageKey varchar(200) [not null]
  FileFormat varchar(20) [not null]
  ContentType varchar(100) [not null]
  FileSize bigint [not null]
  PosterUrl varchar(1000)
  AutoRotate boolean [not null]
  CameraOrbit varchar(100)
  FieldOfView varchar(50)
  Scale numeric(10,4) [not null, default: 1.0]
  UpdatedBy uuid [not null]
  UpdatedAt timestamptz [not null]
  indexes {
    ArtifactId [unique, name: 'IX_artifact_3d_models_ArtifactId']
  }
}

Table commerce_resources {
  Id integer [pk, not null, increment]
  MuseumId integer [not null]
  Name varchar(200) [not null]
  Kind varchar(20) [not null]
  AccessLevel varchar(20) [not null]
  ArtifactId integer
  ScopeReference varchar(200)
  indexes {
    ArtifactId [unique, name: 'IX_commerce_resources_ArtifactId']
    MuseumId [name: 'IX_commerce_resources_MuseumId']
  }
}

