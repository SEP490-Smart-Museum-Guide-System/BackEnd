  "ArtifactId" "integer" [not null]
  "OrderNo" "integer" [not null]
  "TourVersionId" "integer" [not null]
  indexes {
    ("Id") [pk]
    ("ArtifactId") [name: "IX_tour_version_items_ArtifactId"]
    ("TourVersionId", "ArtifactId") [name: "IX_tour_version_items_TourVersionId_ArtifactId", unique]
    ("TourVersionId", "OrderNo") [name: "IX_tour_version_items_TourVersionId_OrderNo", unique]
  }
}

Table "tour_versions" {
  "Id" "integer" [not null]
  "CreatedAt" "timestamp with time zone" [not null]
  "CreatedBy" "uuid" [not null]
  "Description" "character varying(4000)" [not null]
  "EstimatedMinutes" "integer" [not null]
  "PublicAt" "timestamp with time zone"
  "ReviewNote" "character varying(1000)"
  "ReviewedAt" "timestamp with time zone"
  "ReviewedBy" "uuid"
  "Status" "character varying(20)" [not null]
  "SubmittedAt" "timestamp with time zone"
  "SubmittedBy" "uuid"
  "Title" "character varying(200)" [not null]
  "TourId" "integer" [not null]
  "VersionNo" "integer" [not null]
  indexes {
    ("Id") [pk]
    ("CreatedBy") [name: "IX_tour_versions_CreatedBy"]
    ("ReviewedBy") [name: "IX_tour_versions_ReviewedBy"]
    ("SubmittedBy") [name: "IX_tour_versions_SubmittedBy"]
    ("TourId", "Status", "PublicAt") [name: "IX_tour_versions_TourId_Status_PublicAt"]
    ("TourId", "VersionNo") [name: "IX_tour_versions_TourId_VersionNo", unique]
  }
}

Table "tours" {
  "Id" "integer" [not null]
  "CreatedAt" "timestamp with time zone" [not null]
  "CreatedBy" "uuid" [not null]
  "Description" "character varying(4000)" [not null]
  "EstimatedMinutes" "integer" [not null]
  "MuseumId" "integer" [not null]
  "Revision" "integer" [not null]
  "Status" "character varying(20)" [not null]
  "Title" "character varying(200)" [not null]
  indexes {
    ("Id") [pk]
    ("CreatedBy") [name: "IX_tours_CreatedBy"]
    ("MuseumId") [name: "IX_tours_MuseumId"]
  }
}

Table "user_badges" {
  "UserId" "uuid" [not null]
  "BadgeId" "integer" [not null]
  "AwardedAt" "timestamp with time zone" [not null]
  indexes {
    ("UserId", "BadgeId") [pk]
    ("BadgeId") [name: "IX_user_badges_BadgeId"]
  }
}

Table "UserClaims" {
  "Id" "integer" [not null]
  "ClaimType" "text"
  "ClaimValue" "text"
  "UserId" "uuid" [not null]
  indexes {
    ("Id") [pk]
    ("UserId") [name: "IX_UserClaims_UserId"]
  }
}

Table "UserLogins" {
  "LoginProvider" "text" [not null]
  "ProviderKey" "text" [not null]
  "ProviderDisplayName" "text"
  "UserId" "uuid" [not null]
  indexes {
    ("LoginProvider", "ProviderKey") [pk]
    ("UserId") [name: "IX_UserLogins_UserId"]
  }
}

Table "UserRoles" {
  "UserId" "uuid" [not null]
  "RoleId" "uuid" [not null]
  indexes {
    ("UserId", "RoleId") [pk]
    ("RoleId") [name: "IX_UserRoles_RoleId"]
  }
}

Table "Users" {
  "Id" "uuid" [not null]
  "AccessFailedCount" "integer" [not null]
  "ConcurrencyStamp" "text"
  "CreatedAt" "timestamp with time zone" [not null]
  "Email" "character varying(256)"
  "EmailConfirmed" "boolean" [not null]
  "FullName" "character varying(200)" [not null]
  "IsActive" "boolean" [not null]
  "LockoutEnabled" "boolean" [not null]
  "LockoutEnd" "timestamp with time zone"
  "NormalizedEmail" "character varying(256)"
  "NormalizedUserName" "character varying(256)"
  "PasswordHash" "text"
  "PhoneNumber" "text"
  "PhoneNumberConfirmed" "boolean" [not null]
  "SecurityStamp" "text"
  "TwoFactorEnabled" "boolean" [not null]
  "UserName" "character varying(256)"
  indexes {
    ("Id") [pk]
    ("NormalizedEmail") [name: "EmailIndex", unique]
    ("NormalizedUserName") [name: "UserNameIndex", unique]
  }
}

Table "UserTokens" {
  "UserId" "uuid" [not null]
  "LoginProvider" "text" [not null]
  "Name" "text" [not null]
  "Value" "text"
  indexes {
    ("UserId", "LoginProvider", "Name") [pk]
  }
}

Table "visit_feedbacks" {
  "Id" "integer" [not null]
  "ChatbotRating" "integer"
  "Comment" "character varying(2000)"
  "ContentRating" "integer"
  "CreatedAt" "timestamptz" [not null]
  "ModerationNote" "character varying(1000)"
  "ModerationStatus" "character varying(20)" [not null]
  "OverallRating" "integer" [not null]
  "TourRating" "integer"
  "UpdatedAt" "timestamptz"
  "VisitId" "integer" [not null]
  indexes {
    ("Id") [pk]
    ("VisitId") [name: "IX_visit_feedbacks_VisitId", unique]
  }
}

Table "visit_items" {
  "Id" "integer" [not null]
  "ArtifactId" "integer" [not null]
  "LastVisitedAt" "timestamp with time zone" [not null]
  "TourItemId" "integer"
  "TourVersionItemId" "integer"
  "VisitId" "integer" [not null]
  indexes {
    ("Id") [pk]
    ("ArtifactId") [name: "IX_visit_items_ArtifactId"]
    ("TourItemId") [name: "IX_visit_items_TourItemId"]
    ("TourVersionItemId") [name: "IX_visit_items_TourVersionItemId"]
    ("VisitId", "ArtifactId") [name: "IX_visit_items_VisitId_ArtifactId", unique]
  }
}

Table "visits" {
  "Id" "integer" [not null]
  "CompletedAt" "timestamptz"
  "MuseumId" "integer" [not null]
  "PersonalizedTourId" "uuid"
  "StartedAt" "timestamptz" [not null]
  "Status" "character varying(20)" [not null]
  "TourId" "integer"
  "TourVersionId" "integer"
  "VisitorId" "uuid" [not null]
  indexes {
    ("Id") [pk]
    ("MuseumId") [name: "IX_visits_MuseumId"]
    ("PersonalizedTourId") [name: "IX_visits_PersonalizedTourId"]
    ("TourId") [name: "IX_visits_TourId"]
    ("TourVersionId") [name: "IX_visits_TourVersionId"]
    ("VisitorId", "MuseumId", "Status") [name: "IX_visits_VisitorId_MuseumId_Status"]
  }
}

